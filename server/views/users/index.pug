extends ../layouts/application.pug

block header
  h1.my-4= t('views.users.users')

block content
  table.table.table-striped
    thead
      tr
        th= t('views.users.id')
        th= t('views.users.fullName')
        th= t('views.users.email')
        th= t('views.users.createdAt')
        if isAuthenticated()
          th= t('views.users.actions')
    tbody
      each user in users
        tr
          td= user.id
          td= user.fullName
          td= user.email
          td= formatDate(user.createdAt)
          if isAuthenticated()
            td
              a.btn.btn-primary.btn-sm.me-1(href=route('editUser', { id: user.id }))= t('views.users.updateAction')
              +formFor()(action=route('oneUser', { id: user.id }) method='post' class='d-inline')
                input(name='_method' type='hidden' value='delete')
                input.btn.btn-danger.btn-sm(type='submit' value=t('views.users.deleteAction'))
