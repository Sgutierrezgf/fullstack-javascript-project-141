include ../mixins/forms.pug

doctype html
html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    title= t('appName')
    link(href=assetPath('main.css') rel="stylesheet")
    script(src=assetPath('main.js'))
  body.d-flex.flex-column.min-vh-100
    //- Bootstrap Example: Navbar
    //- https://getbootstrap.com/docs/5.3/components/navbar/
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
      .container
        a.navbar-brand(href=route('root'))= t('appName')
        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label=t('layouts.application.toggleNav')
        )
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(href=route('users'))= t('layouts.application.users')
            li.nav-item
              a.nav-link(href=route('statuses'))= t('layouts.application.statuses')
          ul.navbar-nav
            if isAuthenticated()
              li.nav-item
                +buttonTo(route('session'), 'delete')(class="btn nav-link" value=t('layouts.application.signOut'))
            else
              li.nav-item
                a.nav-link(href=route('newSession'))= t('layouts.application.signIn')
              li.nav-item
                a.nav-link(href=route('newUser'))= t('layouts.application.signUp')

    main.container.flex-grow-1.py-4
      each messages, type in reply.flash() || []
        each message in messages
          .alert.alert-dismissible.fade.show(class=`alert-${getAlertClass(type)}` role="alert")
            = message
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label=t('layouts.application.close'))

      block header
      block content

    //- Bootstrap Example: sticky-footer style
    footer.footer.mt-auto.py-3.bg-body-tertiary
      .container
        span.text-body-secondary
          a(target="_blank" rel="noopener noreferrer" href="https://es.hexlet.io")= t('layouts.application.hexlet')
