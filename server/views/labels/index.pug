extends ../layouts/application.pug

block header
  h1.my-4= t('views.labels.labels')

block content
  a.btn.btn-primary.mb-3(href=route('newLabel'))= t('views.labels.createAction')
  table.table.table-striped
    thead
      tr
        th= t('views.labels.id')
        th= t('views.labels.name')
        th= t('views.labels.createdAt')
        th= t('views.labels.actions')
    tbody
      each label in labels
        tr
          td= label.id
          td= label.name
          td= formatDate(label.createdAt)
          td
            a.btn.btn-primary.btn-sm.me-1(href=route('editLabel', { id: label.id }))= t('views.labels.updateAction')
            +formFor()(action=route('oneLabel', { id: label.id }) method='post' class='d-inline')
              input(name='_method' type='hidden' value='delete')
              input.btn.btn-danger.btn-sm(type='submit' value=t('views.labels.deleteAction'))
