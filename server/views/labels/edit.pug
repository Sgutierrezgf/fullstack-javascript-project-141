extends ../layouts/application.pug

block header
  h1.my-4= t('views.labels.update.title')

block content
  +formFor()(action=route('oneLabel', { id: label.id }) method='post')
    input(type="hidden" name="_method" value="patch")
    +input(label, 'name', t('views.labels.name'), errors)(type="text")
    +submit(label)(value=t('views.labels.update.submit'))
