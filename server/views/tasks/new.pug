extends ../layouts/application.pug

block header
  h1.my-4= t('views.tasks.new.title')

block content
  +formFor()(action=route('tasks') method='post')
    +input(task, 'name', t('views.tasks.name'), errors)(type="text")
    +textarea(task, 'description', t('views.tasks.description'), errors)(rows="3")
    +select(task, 'statusId', t('views.tasks.status'), errors)
      option(value='')
      each status in statuses
        option(value=status.id selected=(Number(status.id) === Number(task.statusId)))= status.name
    +select(task, 'executorId', t('views.tasks.executor'), errors)
      option(value='')
      each user in users
        option(value=user.id selected=(Number(user.id) === Number(task.executorId)))= user.fullName
    +submit(task)(value=t('views.tasks.new.submit'))
